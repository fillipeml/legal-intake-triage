# =============================================================================
# Legal intake triage. Copy to ".env" and fill in. NEVER commit the .env.
# Every value below is a placeholder; the demo needs none of them.
# =============================================================================

# --- Mode ------------------------------------------------------------------------
# true = fixture inbox, recorded triage, SQLite state under .demo/, e-mails written to
# .demo/outbox; no network
DEMO_MODE=true
# true = read the real mailbox and triage, but send nothing (shadow mode before go-live)
DRY_RUN=true
# Pins "today" (the demo defaults to 2026-09-21, the Monday the fixtures are built around)
REFERENCE_DATE=
TIMEZONE=America/Sao_Paulo
# State of the firm, for the holiday calendar of the business-day deadlines
HOLIDAY_SUBDIVISION=GO

# --- The firm --------------------------------------------------------------------
FIRM_NAME=Example Law Firm
# The firm's domain: internal senders never open a demand unless they forward one
INTERNAL_DOMAIN=lawfirm.example
# The service account that receives the areas' mail (member of each area group) and the
# copies that close demands
INTAKE_MAILBOX=intake@lawfirm.example
# One JSON per practice area (mailbox, validation mode, taxonomy, lawyers, clients)
AREAS_DIR=areas
# The body sent to the triage is cut here; long e-mails rarely add to it
MAX_BODY_CHARS=15000
# How far back a sweep looks (a missed run is recovered; processed ids are never redone)
SWEEP_LOOKBACK_DAYS=3
# Who gets the failure alerts
ALERT_EMAILS=operator@lawfirm.example

# --- Microsoft Graph (mailbox, Planner, directory) ---------------------------------
# App registration with application permissions Mail.Read + Mail.ReadWrite + Mail.Send,
# Tasks.ReadWrite.All, Group.Read.All, User.Read.All; see docs/GRAPH_SETUP.md
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# --- Model -----------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# The small model that classifies board history titles for the SLA matrix (Batches API)
SLA_CLASSIFIER_MODEL=claude-haiku-4-5

# --- State and console -----------------------------------------------------------
# SQLite with the registry (master record) and, in the demo, the board. PERSISTENT: back it up.
STATE_DB=data/state.sqlite
# Shared password of the console (without it, the console is open: the demo)
CONSOLE_PASSWORD=
# Secret that signs the console's sessions (any long random string)
CONSOLE_SECRET=
